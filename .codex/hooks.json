{
  "description": "Inject the NAMO project-skill reminder at every Codex session boundary.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/session-start-skills.sh\"",
            "timeout": 10,
            "statusMessage": "Loading NAMO project skills"
          }
        ]
      }
    ]
  }
}
