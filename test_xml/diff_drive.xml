<mujoco model="roomba_diffdrive">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <!-- Lighting / rendering -->
  <visual>
    <!-- Camera headlight -->
    <headlight diffuse="0.6 0.6 0.6" ambient="0.25 0.25 0.25" specular="0.2 0.2 0.2"/>
    <!-- Atmosphere -->
    <rgba haze="0.15 0.20 0.25 1"/>
    <!-- Default camera angle -->
    <global azimuth="-120" elevation="-20"/>
  </visual>

  <default>
    <!-- Make contacts stable and wheels grippy -->
    <geom friction="1.2 0.05 0.001" condim="4" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <joint damping="0.05"/>
  </default>

  <!-- Wheel actuator/joint defaults, like TB3 -->
  <default>
    <default class="wheel">
      <joint type="hinge" limited="false" frictionloss="0.05" armature="0.01"/>
      <!-- ctrl is desired wheel ang vel (rad/s) -->
      <velocity kv="8" ctrlrange="-20 20" ctrllimited="true"/>
    </default>
    <default class="wheel_left">
      <!-- wheel spins around its axle -->
      <joint axis="0 1 0"/>
    </default>
    <default class="wheel_right">
      <joint axis="0 1 0"/>
    </default>
  </default>

  <worldbody>
    <!-- Scene lights -->
    <light name="key"  pos="1.5  1.5 2.5" dir="-1 -1 -2" directional="true"
           diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <light name="fill" pos="-1.5 1.0 2.0" dir=" 1 -0.5 -1.5" directional="true"
           diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>

    <!-- Floor -->
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.2 0.25 0.3 1"/>

    <!-- Base -->
    <body name="base" pos="0 0 0.06">
      <freejoint name="base_joint"/>

      <!-- Circular chassis: cylinder size = radius, half-height -->
      <geom name="chassis" type="cylinder" size="0.17 0.04" rgba="0.15 0.15 0.15 1"/>

      <!-- Small front marker so you can see heading -->
      <geom name="front_marker" type="sphere" pos="0.14 0 0.04" size="0.015"
            rgba="0.9 0.2 0.2 1" contype="0" conaffinity="0"/>

      <!-- Left wheel -->
      <body name="wheel_left" pos="0 0.12 0.0">
        <joint name="wheel_left" class="wheel_left"/>
        <!-- wheel geom: cylinder axis is along its local Z, so rotate 90deg about Y to align with axle -->
        <geom name="g_wheel_left" type="cylinder" size="0.035 0.02"
              euler="0 1.57079632679 0" rgba="0.05 0.05 0.05 1"/>
      </body>

      <!-- Right wheel -->
      <body name="wheel_right" pos="0 -0.12 0.0">
        <joint name="wheel_right" class="wheel_right"/>
        <geom name="g_wheel_right" type="cylinder" size="0.035 0.02"
              euler="0 1.57079632679 0" rgba="0.05 0.05 0.05 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity class="wheel_left" name="wheel_left" joint="wheel_left"/>
    <velocity class="wheel_right" name="wheel_right" joint="wheel_right"/>
  </actuator>

  <contact>
    <!-- Like TB3: avoid wheel-chassis collisions -->
    <exclude body1="base" body2="wheel_left"/>
    <exclude body1="base" body2="wheel_right"/>
  </contact>
</mujoco>