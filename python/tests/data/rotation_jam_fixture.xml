<?xml version="1.0"?>
<mujoco model="rotation_jam_fixture">
  <!-- Long bars held between pivot posts so they can turn but barely shift.
       Pushing one end swings the bar until both ends bind on the posts, which
       is the case a translation-only rule throws away: the boundary opens
       because the bar turned, while its centre went almost nowhere.

       obstacle_1_movable has 4 mm of clearance at the posts, which allows a swing
       of about 18 degrees while capping how far its centre can shift at 4 mm.
       obstacle_2_movable has 0.05 mm and cannot turn at all, so it clears
       neither bar and is rolled back. -->
  <option cone="elliptic" integrator="RK4" timestep="0.01"/>
  <default>
    <geom density="1"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05" friction="0.5 0.005 0.001" condim="4"/>
    <body name="walls">
      <geom name="wall_1" type="box" pos="-1.2 0 0.3" size="0.05 1.2 0.3"/>
      <geom name="wall_2" type="box" pos="1.2 0 0.3" size="0.05 1.2 0.3"/>
      <geom name="wall_3" type="box" pos="0 -1.2 0.3" size="1.2 0.05 0.3"/>
      <geom name="wall_4" type="box" pos="0 1.2 0.3" size="1.2 0.05 0.3"/>
      <!-- pivot for the bar that can turn: 4 mm either side -->
      <geom name="pivot_a_top" type="box" pos="-0.5 0.459 0.3" size="0.012 0.02 0.3"/>
      <geom name="pivot_a_bottom" type="box" pos="-0.5 0.341 0.3" size="0.012 0.02 0.3"/>
      <!-- pivot for the bar that cannot: 0.05 mm either side -->
      <geom name="pivot_b_top" type="box" pos="0.5 -0.39505 0.3" size="0.012 0.02 0.3"/>
      <geom name="pivot_b_bottom" type="box" pos="0.5 -0.50495 0.3" size="0.012 0.02 0.3"/>
    </body>
    <body name="robot">
      <joint name="joint_x" type="slide" axis="1 0 0"/>
      <joint name="joint_y" type="slide" axis="0 1 0"/>
      <geom name="robot" type="sphere" pos="0.0 0.0 0.035" size="0.035" mass="5" friction="1 0.005 0.0001" condim="4"/>
    </body>
    <body name="obstacle_1_movable">
      <joint type="free"/>
      <geom name="obstacle_1_movable" type="box" pos="-0.5 0.4 0.05" size="0.18 0.035 0.05" mass="0.1" friction="0 0.005 0.001" condim="4" rgba="1 1 0 1"/>
    </body>
    <body name="obstacle_2_movable">
      <joint type="free"/>
      <geom name="obstacle_2_movable" type="box" pos="0.5 -0.45 0.05" size="0.18 0.035 0.05" mass="0.1" friction="0 0.005 0.001" condim="4" rgba="1 1 0 1"/>
    </body>
    <site name="goal" type="sphere" pos="0.9 0.9 0" size="0.1" rgba="0 1 0 0.5"/>
  </worldbody>
  <actuator>
    <velocity name="actuator_x" joint="joint_x" kv="50" ctrlrange="-0.5 0.5" forcerange="-20 20"/>
    <velocity name="actuator_y" joint="joint_y" kv="50" ctrlrange="-0.5 0.5" forcerange="-20 20"/>
  </actuator>
</mujoco>
