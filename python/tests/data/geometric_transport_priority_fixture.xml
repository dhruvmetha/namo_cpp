<?xml version="1.0" ?>
<mujoco model="geometric_transport_priority_fixture">
  <option cone="elliptic" integrator="RK4" timestep="0.01"/>
  <default>
    <geom density="1"/>
  </default>
  <asset>
    <texture builtin="gradient" height="3072" rgb1="0.3 0.5 0.7" rgb2="0 0 0" type="skybox" width="512"/>
    <texture builtin="checker" height="300" mark="edge" markrgb="0.8 0.8 0.8" name="groundplane" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" type="2d" width="300"/>
    <material name="groundplane" reflectance="0.2" texrepeat="5 5" texture="groundplane" texuniform="true"/>
    <material name="robot" rgba="1.0 1.0 0.0 1.0"/>
  </asset>

  <worldbody>
    <light dir="0 0 -1" directional="true" pos="0 0 1.5"/>
    <geom condim="4" friction="0.5 0.005 0.001" material="groundplane" name="floor" size="0 0 0.05" type="plane"/>

    <!-- Outer bounding walls -->
    <body name="walls">
      <geom condim="4" name="wall_left" pos="-5.0 0.0 0.3" rgba="0.8 0.8 0.8 1.0" size="0.05 5.0 0.3" type="box"/>
      <geom condim="4" name="wall_right" pos="5.0 0.0 0.3" rgba="0.8 0.8 0.8 1.0" size="0.05 5.0 0.3" type="box"/>
      <geom condim="4" name="wall_bottom" pos="0.0 -5.0 0.3" rgba="0.8 0.8 0.8 1.0" size="5.0 0.05 0.3" type="box"/>
      <geom condim="4" name="wall_top" pos="0.0 5.0 0.3" rgba="0.8 0.8 0.8 1.0" size="5.0 0.05 0.3" type="box"/>

      <!-- Corridor walls near the robot->goal path (y=0) to enable static-collision tests -->
      <geom condim="4" name="corridor_wall_top" pos="0.0 0.9 0.3" rgba="0.6 0.6 0.6 1.0" size="5.0 0.05 0.3" type="box"/>
      <geom condim="4" name="corridor_wall_bottom" pos="0.0 -0.9 0.3" rgba="0.6 0.6 0.6 1.0" size="5.0 0.05 0.3" type="box"/>
    </body>

    <!-- Robot starts at origin -->
    <body name="robot">
      <joint axis="1 0 0" name="joint_x" pos="0 0 0" type="slide"/>
      <joint axis="0 1 0" name="joint_y" pos="0 0 0" type="slide"/>
      <geom condim="4" friction="1.0 0.005 0.0001" mass="5.0" name="robot" pos="0.0 0.0 0.15" size="0.15 0.15 0.15" type="sphere"/>
    </body>

    <!-- Movable object under test -->
    <body name="obstacle_1_movable">
      <geom condim="4" euler="0 0 0" friction="0.0 0.005 0.001" mass="0.1" name="obstacle_1_movable" pos="2.0 0.0 0.3" rgba="1 0 0 1" size="0.3 0.3 0.3" type="box"/>
      <joint type="free"/>
    </body>

    <!-- Second movable object for movable-collision test -->
    <body name="obstacle_2_movable">
      <geom condim="4" euler="0 0 0" friction="0.0 0.005 0.001" mass="0.1" name="obstacle_2_movable" pos="2.0 3.0 0.3" rgba="0 0 1 1" size="0.3 0.3 0.3" type="box"/>
      <joint type="free"/>
    </body>

    <!-- Small movable object near the path to enable movable-collision+no-opening without blocking the BFS path -->
    <body name="obstacle_3_movable">
      <geom condim="4" euler="0 0 0" friction="0.0 0.005 0.001" mass="0.1" name="obstacle_3_movable" pos="2.0 0.25 0.3" rgba="1 0 1 1" size="0.05 0.05 0.3" type="box"/>
      <joint type="free"/>
    </body>

    <site name="goal" pos="4.0 0.0 0.0" rgba="0 1 0 0.5" size="0.25 0.25 0.25" type="sphere"/>
  </worldbody>

  <actuator>
    <velocity kv="50" ctrlrange="-0.5 0.5" forcerange="-20 20" joint="joint_x" name="actuator_x"/>
    <velocity kv="50" ctrlrange="-0.5 0.5" forcerange="-20 20" joint="joint_y" name="actuator_y"/>
  </actuator>
</mujoco>
