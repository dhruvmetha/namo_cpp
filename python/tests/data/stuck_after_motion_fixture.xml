<?xml version="1.0"?>
<mujoco model="stuck_after_motion_fixture">
  <!-- Two objects that both end a long push on stuck detection, for opposite
       reasons, so the "keep the motion" rule can be tested from both sides.

       obstacle_1_movable has 19 cm of clear travel before block_a stops it. The
       blocker is far enough that the robot is still ~14 cm short of it when the
       object jams, so the robot never collides and the stuck detector is what
       ends the push.

       obstacle_2_movable starts flush against block_b on its push side. It
       cannot move at all, so the same detector fires with zero displacement. -->
  <option cone="elliptic" integrator="RK4" timestep="0.01"/>
  <default>
    <geom density="1"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05" friction="0.5 0.005 0.001" condim="4"/>
    <body name="walls">
      <geom name="wall_1" type="box" pos="-1 0 0.3" size="0.05 1 0.3"/>
      <geom name="wall_2" type="box" pos="1 0 0.3" size="0.05 1 0.3"/>
      <geom name="wall_3" type="box" pos="0 -1 0.3" size="1 0.05 0.3"/>
      <geom name="wall_4" type="box" pos="0 1 0.3" size="1 0.05 0.3"/>
      <!-- stops obstacle_1_movable after it has travelled -->
      <geom name="block_a" type="box" pos="-0.35 0.30 0.3" size="0.40 0.05 0.3"/>
      <!-- already touching obstacle_2_movable -->
      <geom name="block_b" type="box" pos="0.55 -0.39 0.3" size="0.25 0.05 0.3"/>
    </body>
    <body name="robot">
      <joint name="joint_x" type="slide" axis="1 0 0"/>
      <joint name="joint_y" type="slide" axis="0 1 0"/>
      <geom name="robot" type="sphere" pos="-0.35 -0.55 0.035" size="0.035" mass="5" friction="1 0.005 0.0001" condim="4"/>
    </body>
    <body name="obstacle_1_movable">
      <joint type="free"/>
      <geom name="obstacle_1_movable" type="box" pos="-0.35 0.0 0.05" size="0.06 0.06 0.05" mass="0.1" friction="0 0.005 0.001" condim="4" rgba="1 1 0 1"/>
    </body>
    <body name="obstacle_2_movable">
      <joint type="free"/>
      <geom name="obstacle_2_movable" type="box" pos="0.55 -0.50 0.05" size="0.06 0.06 0.05" mass="0.1" friction="0 0.005 0.001" condim="4" rgba="1 1 0 1"/>
    </body>
    <site name="goal" type="sphere" pos="0.55 0.75 0" size="0.1" rgba="0 1 0 0.5"/>
  </worldbody>
  <actuator>
    <velocity name="actuator_x" joint="joint_x" kv="50" ctrlrange="-0.5 0.5" forcerange="-20 20"/>
    <velocity name="actuator_y" joint="joint_y" kv="50" ctrlrange="-0.5 0.5" forcerange="-20 20"/>
  </actuator>
</mujoco>
