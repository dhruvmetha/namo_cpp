# SLURM job logs (relative #SBATCH --output target); keep the dir, ignore contents
logs/*
!logs/.gitkeep
*.out
external/

# paper-reader: the reading lives here (queue.md + papers/<slug>/notes.md are
# Dhruv's words and belong in git). Everything else under papers/ is a fetched or
# derived copy of a published paper -- excluded, then notes.md re-included, which
# git only honours if the parent dirs are re-included first.
papers/**
!papers/
!papers/*/
!papers/*/notes.md
# highlights.json is PDF annotations made while reading, not a fetched/derived copy --
# re-include it too, or a git clean -fdx / re-clone loses every highlight silently.
!papers/*/highlights.json
