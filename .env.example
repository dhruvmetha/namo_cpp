# =============================================================================
# NAMO machine-local environment  —  TEMPLATE
#
# SETUP (once per machine):
#   cp namo/.env.example  <parent>/.env       # <parent> = dir holding namo/,
#                                             # sage_learning/, mujoco_env_creator/
#   $EDITOR <parent>/.env                     # fill in values for THIS machine
#   python -m pip install python-dotenv       # in the env namo runs under
#
# The real .env lives ONE DIR ABOVE the repos (outside all git repos) and is
# git-ignored regardless. One file, shared by all three repos on the machine.
#
# Consumed by:
#   * shell  -> source namo/scripts/env/activate.sh
#   * python -> python-dotenv (python/namo/__init__.py, scripts/corpus.py)
#
# Composite vars (PYTHONPATH, LD_LIBRARY_PATH) are DERIVED by activate.sh.
# Do NOT set them here.
# =============================================================================

# --- workspace layout ---
NAMO_PARENT=/abs/path/to/parent          # dir containing namo, sage_learning, mujoco_env_creator
NAMO_REPO=${NAMO_PARENT}/namo            # repo dir is 'namo' on ilab, 'namo_cpp' on amarel
NAMO_SAGE=${NAMO_PARENT}/sage_learning
NAMO_ENV_CREATOR=${NAMO_PARENT}/mujoco_env_creator

# --- toolchain ---
MJ_PATH=/abs/path/to/mujoco
NAMO_PYTHON=/abs/path/to/env/bin/python
NAMO_CONDA_SH=                           # path to conda.sh, or empty to skip conda activate
NAMO_CONDA_ENV=                          # conda env dir (required if NAMO_CONDA_SH set)
NAMO_MODULES=                            # e.g. "gcc/12.3 cmake/3.26.5", or empty

# --- data roots ---
NAMO_DATA_ROOT=/abs/path/to/data
NAMO_SCRATCH=${NAMO_DATA_ROOT}
NAMO_DATASETS=${NAMO_DATA_ROOT}/datasets
NAMO_OUTPUTS=${NAMO_DATA_ROOT}/outputs
NAMO_MANIFESTS=${NAMO_DATA_ROOT}/manifests
NAMO_H5=${NAMO_DATA_ROOT}/h5
NAMO_LOGS=${NAMO_DATA_ROOT}/logs

# =============================================================================
# REFERENCE  —  known-good values per machine (copy the block you need above)
# =============================================================================
#
# --- ILAB (ilab1.cs.rutgers.edu) ---
#   NAMO_PARENT=/common/home/dm1487/robotics_research/ktamp
#   MJ_PATH=/common/users/dm1487/ktamp/mujoco
#   NAMO_PYTHON=/common/users/dm1487/envs/mjxrl/bin/python
#   NAMO_CONDA_SH=     NAMO_CONDA_ENV=     NAMO_MODULES=        (all empty)
#   NAMO_DATA_ROOT=/common/users/dm1487/scratch_namo
#
# --- AMAREL ---
#   NAMO_PARENT=/cache/home/dm1487/projects/namo
#   NAMO_REPO=${NAMO_PARENT}/namo_cpp        # NOTE: repo dir is 'namo_cpp' here
#   MJ_PATH=/scratch/dm1487/mujoco/mujoco-3.2.7
#   NAMO_PYTHON=/scratch/dm1487/envs/namo/bin/python
#   NAMO_CONDA_SH=/cache/home/dm1487/miniforge3/etc/profile.d/conda.sh
#   NAMO_CONDA_ENV=/scratch/dm1487/envs/namo
#   NAMO_MODULES=gcc/12.3 cmake/3.26.5
#   NAMO_DATA_ROOT=/scratch/dm1487
#   (amarel still uses scripts/amarel/activate.sh today; it can switch to the
#    generic scripts/env/activate.sh once this .env exists at its parent.)
